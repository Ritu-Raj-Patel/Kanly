# Database
DATABASE_URL=postgresql://user:password@localhost:5432/kanly

# For production databases that require SSL but have self-signed certs (Railway, Render, etc.)
# Set to 'false' to disable SSL certificate verification
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Set to 'false' to completely disable SSL (not recommended for production)
# DATABASE_SSL=false

# NextAuth - REQUIRED for production
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your_secret_key_here

# Set this to your production URL (without trailing slash)
NEXTAUTH_URL=http://localhost:3000

# Optional
ENABLE_DEBUG_ENDPOINTS=false
